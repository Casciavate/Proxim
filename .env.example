# ─── LinkedIn OAuth (Sign In with LinkedIn using OpenID Connect) ──────────────
# Create an app at https://www.linkedin.com/developers/apps
# Add the "Sign In with LinkedIn using OpenID Connect" product, then copy the
# client ID/secret here and register the redirect URL below in the app's Auth tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/auth/linkedin/callback

# ─── Anthropic (AI event search + "who should I meet") ───────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ─── Origins ─────────────────────────────────────────────────────────────────
PORT=3001
APP_ORIGIN=http://localhost:5173
SERVER_URL=http://localhost:3001
# Set to 1 only when the frontend is served from a different site than the API.
# COOKIE_CROSS_SITE=0
