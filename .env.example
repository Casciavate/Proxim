# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Project → Settings → API. Use the SERVICE_ROLE secret, not the anon key —
# every table has RLS enabled with no policies, so only the service role
# (which bypasses RLS) can read or write. Never send this key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sessions ──────────────────────────────────────────────────────────────────
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# ─── LinkedIn OAuth (Sign In with LinkedIn using OpenID Connect) ──────────────
# Create an app at https://www.linkedin.com/developers/apps, add the
# "Sign In with LinkedIn using OpenID Connect" product, and register your
# deployed domain's callback URL as an authorized redirect URL:
#   https://<your-domain>/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Only needed if you want to override the auto-detected redirect URL —
# set it explicitly once you have a stable production domain.
# LINKEDIN_REDIRECT_URI=https://your-domain.example/api/auth/linkedin/callback

# ─── Anthropic (AI event search + "who should I meet") ───────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ─── Local dev only ────────────────────────────────────────────────────────────
PORT=3001
